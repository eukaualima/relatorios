<!DOCTYPE html>
<html lang="pt-pt" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= acao %> Atividade</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Remove setas padrão dos inputs number para visual mais limpo */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }
    </style>
</head>
<body class="h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900 tracking-tight">
            <%= acao %> Atividade
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            <a href="/atividades" class="font-medium text-indigo-600 hover:text-indigo-500 transition-colors">
                &larr; Voltar para a Lista
            </a>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-2xl">
        <div class="bg-white py-8 px-4 shadow-xl sm:rounded-xl sm:px-10 border border-gray-100">
            
            <% if (erro) { %>
                <div class="mb-6 rounded-md bg-red-50 p-4 border-l-4 border-red-500">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-red-700 font-medium"><%= erro %></p>
                        </div>
                    </div>
                </div>
            <% } %>

            <form class="space-y-6" action="<%= rota %>" method="POST">
                
                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    
                    <div class="sm:col-span-4">
                        <label for="mes" class="block text-sm font-medium text-gray-700">Mês de Referência</label>
                        <div class="mt-1">
                            <select id="mes" name="mes" required class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md border shadow-sm">
                                <option value="">Selecione...</option>
                                <% ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'].forEach(m => { %>
                                    <option value="<%= m %>" <%= atividade && atividade.mes === m ? 'selected' : '' %>>
                                        <%= m %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="sm:col-span-2">
                        <label for="ano" class="block text-sm font-medium text-gray-700">Ano</label>
                        <div class="mt-1">
                            <input type="number" name="ano" id="ano" required 
                                value="<%= atividade ? atividade.ano : 2024 %>"
                                class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                        </div>
                    </div>
                </div>

                <div class="border-t border-gray-100 pt-4"></div>

                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                    
                    <div class="sm:col-span-3">
                        <label for="classificacao" class="block text-sm font-medium text-gray-700">Classificação</label>
                        <div class="mt-1">
                            <select id="classificacao" name="classificacao" required class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md border shadow-sm">
                                <option value="">Selecione...</option>
                                <% classificacoes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= atividade && atividade.classificacao == c.id ? 'selected' : '' %>>
                                        <%= c.nome %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label for="grupoComposto" class="block text-sm font-medium text-gray-700">Grupo / Empresa</label>
                        <div class="mt-1">
                            <select id="grupoComposto" name="grupoComposto" required class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md border shadow-sm">
                                <option value="">Selecione...</option>
                                <% grupos.forEach(g => { %>
                                    <option value="<%= g.empresa %>|<%= g.numero %>" 
                                        <%= atividade && atividade.grupoEmpresa == g.empresa && atividade.grupoNumero == g.numero ? 'selected' : '' %>>
                                        <%= g.nome %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6 pt-2">
                    
                    <div class="sm:col-span-3">
                        <label for="horas" class="block text-sm font-medium text-gray-700">Total de Horas</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <input type="number" step="0.1" name="horas" id="horas" 
                                value="<%= atividade ? atividade.horas : '' %>"
                                class="focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-3 pr-12 sm:text-sm border-gray-300 rounded-md" placeholder="0.0">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">hrs</span>
                            </div>
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <label for="qtdestudos" class="block text-sm font-medium text-gray-700">Qtd. de Estudos</label>
                        <div class="mt-1">
                            <input type="number" name="qtdestudos" id="qtdestudos" 
                                value="<%= atividade ? atividade.qtdestudos : '' %>"
                                class="focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md shadow-sm border p-2">
                        </div>
                    </div>
                </div>

                <div class="relative flex items-start py-2">
                    <div class="flex items-center h-5">
                        <input id="participou" name="participou" type="checkbox" 
                            <%= atividade && atividade.participou == 1 ? 'checked' : '' %>
                            class="focus:ring-indigo-500 h-5 w-5 text-indigo-600 border-gray-300 rounded cursor-pointer">
                    </div>
                    <div class="ml-3 text-sm">
                        <label for="participou" class="font-medium text-gray-700 cursor-pointer select-none">Participação Efetiva</label>
                        <p class="text-gray-500">Marque se houve participação direta nos resultados.</p>
                    </div>
                </div>

                <div>
                    <label for="observacao" class="block text-sm font-medium text-gray-700">
                        Observações
                    </label>
                    <div class="mt-1">
                        <textarea id="observacao" name="observacao" rows="3" 
                            class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border border-gray-300 rounded-md p-2 placeholder-gray-400"
                            placeholder="Detalhes adicionais sobre a atividade..."><%= atividade ? atividade.observacao : '' %></textarea>
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200 transform hover:-translate-y-0.5">
                        Salvar Dados
                    </button>
                </div>

            </form>
        </div>
        
        <p class="mt-6 text-center text-xs text-gray-400">
            Sistema de Gestão &copy; <%= new Date().getFullYear() %>
        </p>
    </div>

</body>
</html>