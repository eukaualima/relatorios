<!DOCTYPE html>
<html lang="pt-pt" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Grupos</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.tailwindcss.min.css">

    <style>
        body { font-family: 'Inter', sans-serif; }
        body.modal-open { overflow: hidden; }

        /* Ajustes DataTables */
        .dataTables_wrapper .dataTables_length select {
            padding-right: 2.5rem; border-radius: 0.375rem; border-color: #d1d5db;
        }
        .dataTables_wrapper .dataTables_filter input {
            border-radius: 0.375rem; border-color: #d1d5db; padding-left: 0.75rem;
        }
    </style>
</head>
<body class="h-full py-10 px-4 sm:px-6 lg:px-8">

    <div class="max-w-7xl mx-auto">
        
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <nav class="flex" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-4">
                        <li>
                            <a href="/atividades" class="text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors flex items-center">
                                <svg class="flex-shrink-0 h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                Voltar para Atividades
                            </a>
                        </li>
                    </ol>
                </nav>
                <h2 class="mt-2 text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Gestão de Grupos
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Administre os agrupamentos de atividades por empresa.
                </p>
            </div>
            <div class="mt-4 flex md:mt-0 md:ml-4">
                <a href="/grupos/novo" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all transform hover:-translate-y-0.5">
                    <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
                    </svg>
                    Novo Grupo
                </a>
            </div>
        </div>

        <% if (erro) { %>
            <div class="mb-6 rounded-md bg-red-50 p-4 border-l-4 border-red-500 shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3"><p class="text-sm text-red-700 font-medium"><%= erro %></p></div>
                </div>
            </div>
        <% } %>

        <div class="bg-white shadow-xl rounded-lg overflow-hidden border border-gray-100">
            <div class="p-6">
                <table id="tabelaGrupos" class="w-full text-sm text-left text-gray-500">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 rounded-tl-lg">ID Empresa</th>
                            <th scope="col" class="px-6 py-3">Número</th>
                            <th scope="col" class="px-6 py-3">Nome do Grupo</th>
                            <th scope="col" class="px-6 py-3 text-center rounded-tr-lg">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (lista && lista.length > 0) { %>
                            <% lista.forEach(function(item) { %>
                                <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                                    
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-gray-100 text-gray-800">
                                            EMP-<%= item.empresa %>
                                        </span>
                                    </td>

                                    <td class="px-6 py-4 font-mono text-gray-600">
                                        #<%= item.numero %>
                                    </td>

                                    <td class="px-6 py-4 font-medium text-gray-900">
                                        <%= item.nome %>
                                    </td>

                                    <td class="px-6 py-4 text-center">
                                        <div class="flex item-center justify-center space-x-4">
                                            <a href="/grupos/editar/<%= item.empresa %>/<%= item.numero %>" class="text-indigo-600 hover:text-indigo-900 transition-colors" title="Editar">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                                </svg>
                                            </a>
                                            
                                            <button type="button" 
                                                onclick="abrirModalExclusao('/grupos/<%= item.empresa %>/<%= item.numero %>?method=DELETE')" 
                                                class="text-red-600 hover:text-red-900 transition-colors cursor-pointer focus:outline-none" title="Excluir">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        
        <p class="mt-8 text-center text-xs text-gray-400">Sistema de Gestão &copy; <%= new Date().getFullYear() %></p>
    </div>

    <div id="modalExclusao" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity backdrop-blur-sm"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-100">
                    <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                                <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                                </svg>
                            </div>
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                                <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Excluir Grupo</h3>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-500">
                                        Tem certeza que deseja excluir este grupo? Todas as atividades vinculadas a ele podem ser afetadas.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                        <form id="formDeletar" method="POST" class="inline">
                            <button type="submit" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto transition-colors">
                                Sim, Excluir
                            </button>
                        </form>
                        <button type="button" onclick="fecharModalExclusao()" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto transition-colors">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.tailwindcss.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#tabelaGrupos').DataTable({
                responsive: true,
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-PT.json' },
                dom: '<"flex flex-col md:flex-row justify-between items-center mb-4"lf>rt<"flex flex-col md:flex-row justify-between items-center mt-4"ip>',
                pageLength: 10,
                columnDefs: [
                    { className: "text-center", targets: [3] },
                    { orderable: false, targets: 3 }
                ]
            });
        });

        // Lógica do Modal
        const modal = document.getElementById('modalExclusao');
        const formDeletar = document.getElementById('formDeletar');

        function abrirModalExclusao(rotaAction) {
            formDeletar.action = rotaAction;
            modal.classList.remove('hidden');
            document.body.classList.add('modal-open');
        }

        function fecharModalExclusao() {
            modal.classList.add('hidden');
            document.body.classList.remove('modal-open');
        }

        window.onclick = function(event) {
            if (event.target.classList.contains('bg-gray-500')) fecharModalExclusao();
        }
        
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") fecharModalExclusao();
        });
    </script>
</body>
</html>